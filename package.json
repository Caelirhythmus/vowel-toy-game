{
  "name": "vowel-change-lab",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "元音演变实验室 · Vowel Change Lab — 语音学学习小游戏（Vue 3 + TypeScript + Vite）",
  "scripts": {
    "vendor": "node scripts/vendor-espeak.mjs && node scripts/vendor-piper.mjs",
    "voices:prepare": "node scripts/prepare-npm-voices.mjs",
    "dev": "npm run vendor && vite",
    "build": "npm run vendor && vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "espeak-ng": "^1.0.2",
    "fflate": "^0.8.3",
    "onnxruntime-web": "1.18.0",
    "vue": "^3.5.41",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "happy-dom": "^20.11.2",
    "typescript": "~5.9.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.10"
  }
}
